# Calculate TOTAL EFFECT for unmarried men (main + interaction)
mge_total_unmarried <- mge_marital_full %>%
  select(-lower, -upper) %>%
  pivot_wider(names_from = effect_type, values_from = c(coef, se)) %>%
  mutate(
    total_coef_unmarried = `coef_Main MGE Effect\n(Married men)` + `coef_Interaction\n(Not Married × MGE)`,
    # For standard error of sum, use sqrt(se1^2 + se2^2) assuming independence
    total_se_unmarried = sqrt(`se_Main MGE Effect\n(Married men)`^2 + `se_Interaction\n(Not Married × MGE)`^2),
    lower_unmarried = total_coef_unmarried - 1.96 * total_se_unmarried,
    upper_unmarried = total_coef_unmarried + 1.96 * total_se_unmarried
  )

# Create comparison plot: Married vs Unmarried total effects
comparison_data <- bind_rows(
  mge_marital_full %>%
    filter(effect_type == "Main MGE Effect\n(Married men)") %>%
    mutate(group = "Married"),
  mge_total_unmarried %>%
    mutate(
      group = "Unmarried",
      coef = total_coef_unmarried,
      se = total_se_unmarried,
      lower = lower_unmarried,
      upper = upper_unmarried
    ) %>%
    select(time, outcome, outcome_label, outcome_category, outcome_order, 
           group, coef, se, lower, upper)
)

p_comparison <- ggplot(comparison_data, 
                       aes(x = fct_reorder(outcome_label, outcome_order),
                           y = coef, color = interaction(time, group))) +
  geom_hline(yintercept = 0, linetype = "solid", color = "gray40", alpha = 0.4) +
  geom_errorbar(aes(ymin = lower, ymax = upper),
                width = 0.15,
