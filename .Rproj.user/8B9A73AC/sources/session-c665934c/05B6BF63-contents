  facet_grid(outcome_category ~ ., scales = "free_y", space = "free_y") +
  coord_flip() +
  scale_color_manual(values = time_colors,
                     name = "") +
  labs(
    title = "Male Gender Expression on LE8 Outcomes in Men",
    x = NULL,
    y = "MGE Coefficient (95% CI)",
  ) +
  theme_bw(base_size = 12) +
  theme(
    plot.title = element_text(size = 14, face = "bold", hjust = 0),
    plot.subtitle = element_text(size = 11, color = "gray40", hjust = 0),
    plot.caption = element_text(size = 9, color = "gray50", hjust = 0),
    strip.text.y = element_text(size = 11, face = "bold", angle = 0),
    strip.background = element_rect(fill = "gray94", color = NA),
    panel.spacing = unit(1.2, "lines"),
    legend.position = "top",
    axis.text.y = element_text(hjust = 1),
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_line(color = "gray90", size = 0.4)
  )

