# Load required libraries
library(ggplot2)
library(dplyr)
library(tidyr)
library(scales)
library(forcats)

# Create dataframe with MGE results
mge_results <- tribble(
  ~time, ~outcome, ~coef, ~se, ~significance,
  # Biomarker measures
  "Adolescent MGE", "bp_score", 1.062, 0.884, "",
  "Young Adult MGE", "bp_score", 1.620, 0.881, "*",
  "Adolescent MGE", "glucose_score", 1.745, 0.843, "**",
  "Young Adult MGE", "glucose_score", 1.856, 0.796, "**",
  "Adolescent MGE", "lipid_score", -0.770, 1.235, "",
  "Young Adult MGE", "lipid_score", 0.531, 1.267, "",
  "Adolescent MGE", "bmi_score", 3.150, 1.051, "***",
  "Young Adult MGE", "bmi_score", 1.473, 1.128, "",
  # Lifestyle factors
  "Adolescent MGE", "activity_score", 0.123, 0.735, "",
  "Young Adult MGE", "activity_score", 1.078, 0.744, "",
  "Adolescent MGE", "diet_score", -1.587, 0.791, "**",
  "Young Adult MGE", "diet_score", -0.994, 0.738, "",
  "Adolescent MGE", "smoking_score", -3.257, 0.875, "***",
  "Young Adult MGE", "smoking_score", -5.761, 0.856, "***",
  "Adolescent MGE", "sleep_score", -0.500, 0.492, "",
  "Young Adult MGE", "sleep_score", -0.074, 0.554, "",
  # Composite measure
  "Adolescent MGE", "LE8", -0.175, 0.472, "",
  "Young Adult MGE", "LE8", 0.278, 0.487, ""
)

# Process data
mge_results <- mge_results %>%
  mutate(
    # Calculate confidence intervals
    lower = coef - 1.96 * se,
    upper = coef + 1.96 * se,
    
    # Create better labels for outcomes
    outcome_label = case_when(
      outcome == "bp_score" ~ "Blood Pressure",
      outcome == "glucose_score" ~ "Glucose",
      outcome == "lipid_score" ~ "Lipid",
      outcome == "bmi_score" ~ "BMI",
      outcome == "activity_score" ~ "Physical Activity",
      outcome == "diet_score" ~ "Diet Quality",
      outcome == "smoking_score" ~ "Smoking",
      outcome == "sleep_score" ~ "Sleep Quality",
      outcome == "LE8" ~ "Life's Essential 8",
      TRUE ~ outcome
    ),
    
    # Create three distinct categories
    outcome_category = factor(
      case_when(
        outcome %in% c("bp_score", "glucose_score", "lipid_score", "bmi_score") ~ "Biomarker \nMeasures",
        outcome %in% c("activity_score", "diet_score", "smoking_score", "sleep_score") ~ "Lifestyle \nFactors",
        outcome == "LE8" ~ "Composite \nScore",
        TRUE ~ "Other"
      ),
      levels = c("Biomarker \nMeasures", "Lifestyle \nFactors", "Composite \nScore")
    ),
    
    # Set order for outcomes within categories
    outcome_order = case_when(
      outcome == "bp_score" ~ 1,
      outcome == "glucose_score" ~ 2,
      outcome == "lipid_score" ~ 3,
      outcome == "bmi_score" ~ 4,
      outcome == "activity_score" ~ 5,
      outcome == "diet_score" ~ 6,
      outcome == "smoking_score" ~ 7,
      outcome == "sleep_score" ~ 8,
      outcome == "LE8" ~ 9,
      TRUE ~ 10
    ),
    
    # Factor for time with correct order
    time = factor(time, levels = c("Adolescent MGE", "Young Adult MGE"))
  ) %>%
  arrange(outcome_order)

# Create custom color palette
time_colors <- c("Adolescent MGE" = "#2166AC", "Young Adult MGE" = "#D6604D")

# Clean faceted plot
p_clean <- ggplot(mge_results, aes(x = fct_reorder(outcome_label, outcome_order), 
                                   y = coef, color = time)) +
  geom_hline(yintercept = 0, linetype = "solid", color = "gray40", alpha = 0.4) +
